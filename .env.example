# Autonomous AI Lab Assistant Configuration
# Copy this file to .env and configure keys if desired.
# None of these keys are mandatory for core functionality!

# General Settings
DATABASE_URL=sqlite:///./data/lab_assistant.db
DEFAULT_FRAMEWORK=scikit-learn
DEFAULT_EXECUTION_MODE=local
RANDOM_SEED=42
EXECUTION_TIMEOUT_SECONDS=300

# Optional Large Language Model (LLM) Integration
# Supported: gemini, openai, anthropic, or none (default)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Optional Dataset Repository Credentials
HF_TOKEN=
KAGGLE_USERNAME=
KAGGLE_KEY=
OPENML_API_KEY=
